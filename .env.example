# Copy to .env and adjust. Never commit your actual keys.

# Network: 0.0.0.0 lets other devices on your network connect.
HOST=0.0.0.0
PORT=3000
# Database, encryption secret and backups (default: ./data).
# FORM_DATA_DIR=/path/to/form-data

# Optional shared AI connection for everyone on this server. Administrators can
# also set it in the app (Account → Shared AI connection), which takes precedence.
# AI_PROVIDER: openai | anthropic | gemini | openrouter | ollama | compatible
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_BASE_URL=            # ollama / compatible endpoints only
# Earlier OpenAI-only variables still work:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# Requests per person per day on the shared connection (editable in the app).
# AI_SHARED_DAILY_LIMIT=50

# Encrypts saved API keys. Generated into the data folder when unset.
# Keep an existing value: changing it makes saved keys unreadable.
# AI_KEY_ENCRYPTION_SECRET=

# Allow non-admins to point their AI connection at custom endpoints (Ollama or
# OpenAI-compatible URLs). Off by default: the server fetches those URLs.
# FORM_ALLOW_CUSTOM_AI_URLS=1
# Set only behind a reverse proxy or tunnel that sets X-Forwarded-* headers.
# FORM_TRUST_PROXY=1
